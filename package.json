{
  "name": "glow",
  "version": "1.0.0",
  "description": "Interactive isometric dependency dashboard and Claude skill",
  "private": true,
  "scripts": {
    "test": "node --test",
    "build": "node build.js",
    "dev": "node build.js --serve",
    "release:prepare": "node scripts/prepare-cli-release.mjs",
    "release:apply": "node scripts/prepare-cli-release.mjs --apply",
    "package:skill": "npm run build && mkdir -p dist/downloads && tar -czf dist/downloads/glow.tar.gz -C dist/skill glow"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sujithq/glow"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
